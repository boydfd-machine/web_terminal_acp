APP_HOST=127.0.0.1
APP_PORT=8000
# Comma-separated frontend origins allowed to call the backend API from a browser.
# For LAN Vite testing, set: CORS_ALLOW_ORIGINS=http://dev-host:5173
CORS_ALLOW_ORIGINS=
# Override when this subnet conflicts with another Docker or host network.
COMPOSE_NETWORK_SUBNET=10.201.0.0/24
DATABASE_URL=postgresql+asyncpg://web_terminal:dev_password@127.0.0.1:15436/web_terminal_acp
# SQLAlchemy async engine pool. Defaults cover HTTP API + websockets + background workers.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=1800
POSTGRES_LOG_MIN_DURATION_STATEMENT_MS=500
ELASTICSEARCH_URL=http://127.0.0.1:19201
REDIS_URL=redis://127.0.0.1:16379/0
REDIS_MAXMEMORY=2gb
REDIS_MEMORY_LIMIT=3G
AGENT_EVENT_STREAM_KEY=web-terminal-acp:agent-events
AGENT_EVENT_DEAD_LETTER_STREAM_KEY=web-terminal-acp:agent-events:dead-letter
AGENT_EVENT_CONSUMER_GROUP=agent-event-ingest
AGENT_EVENT_STREAM_MAXLEN=50000
AGENT_EVENT_WORKER_BATCH_SIZE=100
AGENT_EVENT_WORKER_BLOCK_MS=1000
AGENT_EVENT_CLAIM_IDLE_MS=60000
AGENT_EVENT_MAX_DELIVERIES=5
AGENT_EVENT_REDIS_TIMEOUT_SECONDS=0.2
UI_EVENT_REDIS_CHANNEL=web-terminal-acp:ui-events
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
MINIO_API_PUBLISHED_PORT=19000
MINIO_CONSOLE_PUBLISHED_PORT=19001
PROJECT_TODO_ATTACHMENT_S3_ENDPOINT_URL=/minio
PROJECT_TODO_ATTACHMENT_S3_INTERNAL_ENDPOINT_URL=http://minio:9000
PROJECT_TODO_ATTACHMENT_S3_REGION=us-east-1
PROJECT_TODO_ATTACHMENT_S3_BUCKET=project-todo-attachments
PROJECT_TODO_ATTACHMENT_S3_ACCESS_KEY=web_terminal
PROJECT_TODO_ATTACHMENT_S3_SECRET_KEY=web_terminal_dev_secret
PROJECT_TODO_ATTACHMENT_S3_CORS_ALLOW_ORIGIN=*
PROJECT_TODO_ATTACHMENT_PRESIGN_TTL_SECONDS=900
PROJECT_TODO_ATTACHMENT_MAX_BYTES=20971520
PROJECT_TODO_ATTACHMENT_CLIENT_TEMP_ROOT=/tmp/web-terminal-acp/project-todo-attachments
WEB_TERMINAL_AUTH_SECRET=
WEB_TERMINAL_AUTH_SESSION_TTL_SECONDS=604800
# Keycloak browser login. When these three values are set, Keycloak mode replaces
# the built-in shared-secret login. The frontend uses Authorization Code + PKCE,
# and the backend exchanges/verifies tokens so KEYCLOAK_CLIENT_SECRET is never
# exposed to the browser.
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Optional offline/static verification key. Leave empty to fetch JWKS from Keycloak.
KEYCLOAK_PUBLIC_KEY_PEM=
KEYCLOAK_JWKS_CACHE_TTL_SECONDS=300
TMUX_POOL_SESSION=web_terminal_acp_pool
# auto uses the backend/client user's login shell. Set /bin/bash or /usr/bin/zsh to force one.
DEFAULT_SHELL=auto
CLAUDE_PROJECTS_DIR=~/.claude/projects
HOST_CLAUDE_CONFIG_DIR=~/.claude
HOST_CLAUDE_JSON=~/.claude.json
CODEX_CONFIG_DIR=~/.codex
AGENTS_CONFIG_DIR=~/.agents
ACPX_CONFIG_DIR=~/.acpx
WORKSPACE_DIR=~/workspace
DEBIAN_MIRROR=
NODE_VERSION=22.22.3
NPM_REGISTRY=

# Docker frontend build skips electron binary download (see frontend/Dockerfile).
# For local electron:dev, do NOT set ELECTRON_SKIP_BINARY_DOWNLOAD.
# HTTP_PROXY/HTTPS_PROXY are not wired into docker-compose builds; the npm registry
# mirror above is usually enough. Electron downloads from GitHub, not npm.
# ELECTRON_SKIP_BINARY_DOWNLOAD=1

# LLM used by the summary worker (OpenAI-compatible API).
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPAT_API_KEY=dev-local-key
OPENAI_COMPAT_MODEL=local-summarizer
OPENAI_COMPAT_TIMEOUT_SECONDS=60

# Terminal auto-summary scheduling (backend Settings).
# Shell user input: schedule after idle; each new command resets the idle timer.
# Only terminal_input_command events count — terminal output and agent events do not extend idle.
TERMINAL_SUMMARY_IDLE_SECONDS=20
# First summary cap while input keeps arriving (min of idle and this window from first command).
TERMINAL_SUMMARY_INITIAL_MAX_WAIT_SECONDS=120
# Minimum interval between summaries after the first succeeded job.
TERMINAL_SUMMARY_REPEAT_SECONDS=600
# Max bytes of command history sent to the summarizer per window.
TERMINAL_SUMMARY_INPUT_CONTEXT_MAX_BYTES=32768
# Max seconds to wait for terminal artifact generation before marking it failed.
TERMINAL_ARTIFACT_GENERATION_TIMEOUT_SECONDS=1800
# Language hint for generated title/summary text (e.g. 中文, English).
SUMMARY_OUTPUT_LANGUAGE=中文

# Leave empty for the Docker frontend so nginx proxies /api and WebSocket traffic
# to the backend container. For local Vite development, use http://127.0.0.1:8000.
VITE_API_BASE=
# Leave empty to use the same API origin shown in Settings. Set this only when
# remote clients need a different externally reachable backend/proxy URL.
VITE_CLIENT_AGENT_SERVER_URL=
# New-user onboarding is disabled by default. Set to true before building the
# frontend image when you want the UI walkthrough and restart button.
VITE_ENABLE_ONBOARDING=
# Debug page annotation is enabled by default in local Docker Compose builds.
# Set to false before building the frontend image to hide the selector entry.
VITE_ENABLE_PAGE_ANNOTATION=true
